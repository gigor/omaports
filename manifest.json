{
  "schemaVersion": 1,
  "id": "yuler.omaports",
  "name": "Port Manager",
  "version": "1.1.0",
  "author": "yuler",
  "license": "MIT",
  "description": "Find open TCP ports and close them from the Omarchy bar and overlay.",
  "kinds": ["bar-widget", "overlay"],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "overlay": "Overlay.qml"
  },
  "barWidget": {
    "displayName": "Port Manager",
    "description": "Listening ports on the bar. Open a port with Enter, or kill it with x.",
    "category": "Developer Tools",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "killSignal": "TERM",
      "includeUdp": false,
      "includeDocker": false,
      "dockerSocket": "/var/run/docker.sock",
      "ignoredPorts": "53,631,5353",
      "httpsPorts": "443,8443",
      "refreshIntervalSec": 5
    },
    "schema": [
      {
        "key": "killSignal",
        "type": "enum",
        "label": "Kill signal",
        "options": ["TERM", "KILL"],
        "defaultValue": "TERM",
        "description": "Signal sent after you confirm. Always asks first."
      },
      {
        "key": "includeDocker",
        "type": "enum",
        "label": "Docker published ports",
        "options": ["On", "Off"],
        "defaultValue": "Off",
        "description": "Disabled by default. Uses only the configured local Unix socket."
      },
      {
        "key": "dockerSocket",
        "type": "string",
        "label": "Docker socket",
        "defaultValue": "/var/run/docker.sock",
        "description": "Absolute path to a local Unix socket. TCP and SSH endpoints are refused."
      },
      {
        "key": "includeUdp",
        "type": "enum",
        "label": "Include UDP",
        "options": ["Off", "On"],
        "defaultValue": "Off"
      },
      {
        "key": "ignoredPorts",
        "type": "string",
        "label": "Ignored ports",
        "defaultValue": "53,631,5353"
      },
      {
        "key": "httpsPorts",
        "type": "string",
        "label": "HTTPS ports",
        "defaultValue": "443,8443"
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 2,
        "max": 120,
        "step": 1,
        "defaultValue": 5
      }
    ]
  }
}
